# 最初にすべての階層のファイルを無視します
# 階層は必要なだけ追加する
### all ignore ###
/*
/.**

# .gitignoreは上から解釈されていくので
# 管理対象のファイルをホワイトリストのように追記します
### not ignore ###
!.gitconfig
!.gitignore
!/.config/
!/.config/starship.toml
!/.config/fish/
!/.config/fish/config.fish
!/.config/fish/fish_plugins
!/.config/git/
!/.config/git/ignore

# Public Codex workflow package; private runtime files stay ignored inside codex/.gitignore.
!/README.md
!/codex/
